# Copy to .env (never commit .env). Each owner fills their own keys.

# AI (Luan)
DEEPGRAM_API_KEY=
GEMINI_API_KEY=          # Google AI Studio key, for direct debrief feedback
DANA_MODEL=gemini-2.5-flash
DANA_FACTS=http://localhost:8000   # backend base URL; "fake" = voice/fake_facts.json

# Backend (Duy). One .env for the whole repo: this file's copy at the repo root.
INTERNAL_KEY=            # shared secret: the Dana relay sends it as X-Internal-Key
DEMO_TEAM=duy,tung,luan,demo-a,demo-b   # handles allowed as X-Demo-User in demo mode
SCENARIO_PATH=           # empty = scenario/scenario.json
DATABASE_URL=
GITHUB_TOKEN=
PILOT_REPOS=
MENTOR_GITHUB=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
AUTH0_DOMAIN=            # empty = demo mode (X-Demo-User)
AUTH0_AUDIENCE=

# Frontend (Tung)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_WS=ws://localhost:8000
