# Copy to .env at the repo root (never commit .env). Each owner fills their own keys.
# Put comments on their own line: "NAME=   # note" makes the note the value.

# ---- AI (Luan) ----
DEEPGRAM_API_KEY=
# Optional, not used by Dana (only for P1 extras like the outreach draft)
GEMINI_API_KEY=
DANA_MODEL=gemini-2.5-flash
# Backend base URL; "fake" = voice/fake_facts.json
DANA_FACTS=http://localhost:8000

# ---- Backend (Duy). One .env for the whole repo: this one, at the repo root. ----
# Shared secret: the Dana relay sends it as X-Internal-Key
INTERNAL_KEY=
# Handles allowed as X-Demo-User in demo mode
DEMO_TEAM=duy,tung,luan,demo-a,demo-b
# Empty = scenario/scenario.json
SCENARIO_PATH=
# Tiger Data connection string (postgres://...?sslmode=require). Empty = local SQLite.
# If Tiger Data is unreachable at startup, the API falls back to SQLite and keeps running.
DATABASE_URL=
# Empty = services/api/data/incident_lab.db
SQLITE_PATH=
# Read-only token; the pilot repo as owner/repo; mentors' GitHub logins (only people who agreed)
GITHUB_TOKEN=
PILOT_REPOS=
MENTOR_GITHUB=
# Adzuna keys, used only by `python adzuna.py`
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Empty = services/api/data/jobs_snapshot.json
JOBS_SNAPSHOT_PATH=
# Empty = services/api/data/next_fixes.json (written by `python oss.py`, uses GITHUB_TOKEN)
NEXT_FIXES_SNAPSHOT_PATH=
# Empty = demo mode (X-Demo-User). Set both only once the web app's Auth0 login works.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Web app origin(s), comma-separated; empty = all origins (dev only)
CORS_ORIGINS=

# ---- Frontend (Tung) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_WS=ws://localhost:8000
